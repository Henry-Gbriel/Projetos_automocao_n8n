      "parameters": {
        "jsCode": "const registros = $input.all();\n\nconst linhas = registros.map(item => {\n  const r = item.json;\n\n  return `\n    <tr>\n      <td>${r.nome ?? ''}</td>\n      <td>${r.email ?? ''}</td>\n      <td>${r.produto ?? ''}</td>\n      <td>${r.quantidade ?? ''}</td>\n      <td>R$ ${r.valor_total ?? ''}</td>\n    </tr>\n  `;\n}).join('');\n\nreturn [{\n  json: {\n    assunto: 'Relatório de clientes e consumos',\n    mensagem: `\n      <h2>Relatório de clientes e consumos</h2>\n      <p>Total de registros: ${registros.length}</p>\n\n      <table border=\"1\" cellpadding=\"8\" cellspacing=\"0\">\n        <tr>\n          <th>Cliente</th>\n          <th>E-mail</th>\n          <th>Produto</th>\n          <th>Quantidade</th>\n          <th>Valor total</th>\n        </tr>\n        ${linhas}\n      </table>\n    `\n  }\n}];"
